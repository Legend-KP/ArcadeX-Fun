legacy-peer-deps=true
# Cloudflare CI + pnpm: hoist packages that Next/TS resolve from the app root.
public-hoist-pattern[]=*@neynar*
public-hoist-pattern[]=*@farcaster*
public-hoist-pattern[]=*@wallet-standard*
public-hoist-pattern[]=*@mysten*
public-hoist-pattern[]=*@stellar*
public-hoist-pattern[]=*starknetkit*
