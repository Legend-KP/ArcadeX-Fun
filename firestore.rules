rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog: active games only. Server Admin SDK bypasses these rules —
    // API routes must still enforce admin auth for mutations.
    match /games/{gameId} {
      allow read: if resource.data.active != false;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
