rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client access. The Worker reads/writes with a service account
    // (Admin REST), which bypasses these rules. Players and admin UI use
    // /api/games — never the Firestore browser SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
